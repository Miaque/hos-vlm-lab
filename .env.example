# 在启动进程的环境变量中设置；程序不会自动读取 .env。
# BASE_URL 包含服务路径前缀（例如 /v1），程序追加 /chat/completions。
VLM_DATA_DIR=data
# 以下四个模型共用此连接；空配置在界面显示不可用。
VLM_BASE_URL=
VLM_API_KEY=
DEEPSEEK_MODEL_ID=deepseek-flash
# 各 PROFILE 待共享服务的实际模型能力确证后填写。
DEEPSEEK_PROFILE=
QWEN36_MODEL_ID=qwen3.6-flash
QWEN36_PROFILE=
QWEN38_MODEL_ID=qwen3.8-flash
QWEN38_PROFILE=
KIMI_MODEL_ID=kimi-k2.6
KIMI_PROFILE=
# 独立部署：BASE_URL 包含服务要求的路径前缀（例如 /v1），程序追加 /chat/completions。
# 不复用 VLM 的连接或密钥；PROFILE 待实际服务商与能力确证后填写。
QWEN36_27B_BASE_URL=
QWEN36_27B_API_KEY=
QWEN36_27B_MODEL_ID=qwen3.6-27b
QWEN36_27B_PROFILE=
QWEN36_27B_PRICING_JSON=
# Qwen/Kimi 参数上限尚未确证；仅填写连接不会解除能力校验。
# 可选价格对象；空值表示未知。结构及有效时段见 README，不内置市场价格。
DEEPSEEK_PRICING_JSON=
QWEN36_PRICING_JSON=
QWEN38_PRICING_JSON=
KIMI_PRICING_JSON=
