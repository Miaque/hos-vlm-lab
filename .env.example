# 复制为 .env 后启动时自动读取；已有环境变量优先。
# 无需配置 *_PROFILE，旧值不再读取。
# BASE_URL 包含服务路径前缀（例如 /v1），程序追加 /chat/completions。
VLM_DATA_DIR=data
# 以下四个模型共用此连接；空配置在界面显示不可用。
VLM_BASE_URL=
VLM_API_KEY=
DEEPSEEK_MODEL_ID=deepseek-flash
QWEN36_MODEL_ID=qwen3.6-flash
QWEN38_MODEL_ID=qwen3.8-flash
KIMI_MODEL_ID=kimi-k2.6
# 独立部署：BASE_URL 包含服务要求的路径前缀（例如 /v1），程序追加 /chat/completions。
# 不复用 VLM 的连接或密钥。
QWEN36_27B_BASE_URL=
QWEN36_27B_API_KEY=
QWEN36_27B_MODEL_ID=qwen3.6-27b
# 官方 API 价格快照：2026-09-12 查询，单位为人民币元/百万 token。
# 用 uv run hos-vlm-lab 自动加载；JSON 外层单引号用于保留内部双引号。
# valid_until 是本示例的人工复核期限（不含该时刻），不是官方保证有效期；到期费用显示未知。
# 当前仅支持固定单价，不自动切换时段、输入阶梯或缓存计费方式；实际账单可能不同。
# Qwen 采用百炼华北2（北京）实时调用原价，不含 Batch、活动或缓存折扣。
# 未配置 cache_read_per_million 时，所有输入按普通输入价估算，不扣除缓存优惠。
# 空价格表示未知；字段含义见 README。

# DeepSeek 默认高峰价：输入2、输出8、缓存命中输入0.04。
# 高峰：北京时间周一至周五 09:00-12:00、14:00-18:00；其余为空闲时段。
# 空闲调用需手动将下面三个单价分别改为 1、4、0.02；不切换则按高峰价估算。
DEEPSEEK_PRICING_JSON='{"currency":"CNY","source":"https://api-docs.deepseek.com/zh-cn/quick_start/pricing/ （2026-09-12，高峰固定价）","valid_from":"2026-09-12T00:00:00+08:00","valid_until":"2026-10-01T00:00:00+08:00","input_per_million":"2","output_per_million":"8","cache_read_per_million":"0.04"}'

# Qwen3.6-Flash：单次输入 <=256K；256K<输入<=1M 时整次请求改用输入4.8、输出28.8。
QWEN36_PRICING_JSON='{"currency":"CNY","source":"https://help.aliyun.com/zh/model-studio/model-pricing （2026-09-12，北京，输入<=256K）","valid_from":"2026-09-12T00:00:00+08:00","valid_until":"2026-10-01T00:00:00+08:00","input_per_million":"1.2","output_per_million":"7.2"}'

# Qwen3.8-Flash：单次输入 <=1M；缓存单价须另查官方控制台，不套用通用折扣。
QWEN38_PRICING_JSON='{"currency":"CNY","source":"https://help.aliyun.com/zh/model-studio/model-pricing （2026-09-12，北京，输入<=1M）","valid_from":"2026-09-12T00:00:00+08:00","valid_until":"2026-10-01T00:00:00+08:00","input_per_million":"0.8","output_per_million":"2.7"}'

# Kimi K2.6：月之暗面官方人民币价，缓存命中输入1.1。
KIMI_PRICING_JSON='{"currency":"CNY","source":"https://platform.kimi.com/docs/pricing/chat （2026-09-12）","valid_from":"2026-09-12T00:00:00+08:00","valid_until":"2026-10-01T00:00:00+08:00","input_per_million":"6.5","output_per_million":"27","cache_read_per_million":"1.1"}'

# Qwen3.6-27B：单次输入 <=256K；按官方 API 价格比较，不代表独立部署成本。
QWEN36_27B_PRICING_JSON='{"currency":"CNY","source":"https://help.aliyun.com/zh/model-studio/model-pricing （2026-09-12，北京，输入<=256K）","valid_from":"2026-09-12T00:00:00+08:00","valid_until":"2026-10-01T00:00:00+08:00","input_per_million":"3","output_per_million":"18"}'
